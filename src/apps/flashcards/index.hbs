<!DOCTYPE html>
<html lang="fr-FR">
<head>
  <meta charset="utf-8"/>
  <title>Mathrix</title>

  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <base href="{{ globals 'base_href' }}">

  <link href="https://cdn.jsdelivr.net/npm/katex@0.11.1/dist/katex.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@300;400&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600&display=swap" rel="stylesheet">
</head>

<body>
<flashcard-app>
  <section class="flashcard__screen flashcard__play-screen">
    <div class="flashcard__container">
      {{#forEach content}}
        <div class="flashcard">
          <div class="flashcard__front">
            {{> wall wall=this.front }}
          </div>
          <div class="flashcard__back">
            {{> wall wall=this.back }}
          </div>
        </div>
      {{/forEach}}
    </div>
  </section>
</flashcard-app>
</body>
</html>
