<!DOCTYPE html>
<html lang="fr-FR">
  <head>
    <meta charset="utf-8"/>
    <title>Mathrix</title>

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <base href="{{ globals 'base_href' }}">

    <link href="https://cdn.jsdelivr.net/npm/katex@0.11.1/dist/katex.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@300;400&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@500;600&display=swap" rel="stylesheet">
  </head>

  <body>
    <exercise-app class="{{#unless nextId}}exercise__last{{/unless}}">
      <h1 class="main-title">{{ katex subject.name }}</h1>

      <div class="exercise__selector">
        {{#forEach exercises }}
          <button
            class="exercise__link {{#if (eq id ../exercise.id)}}exercise__link-current{{/if}}"
            data-id="{{ id }}">
            {{ index }}
          </button>
        {{/forEach}}
      </div>

      {{#forEach exercise.questions }}
        <div class="exercise">
          {{> wall wall=this }}

          <div class="exercise__choices">
            {{#forEach (itemAt ../exercise.choices (minus index 1)) }}
              <button
                class="btn btn-secondary exercise__choice"
                data-question="{{ minus ../index 1 }}"
                data-valid="{{inArray (itemAt ../../exercise.solutions (minus ../index 1)) (minus index 1) }}">
                {{> wall wall=this}}
              </button>
            {{/forEach}}
          </div>

          <div class="exercise__explanation">
            <h3 class="exercise__explanation-title">Explications</h3>
            {{#forEach (itemAt ../exercise.explanations (minus index 1))}}
              <div class="exercise__hint" data-question="{{ minus ../index 1 }}">
                {{> wall wall=this }}
              </div>
            {{/forEach}}
          </div>

          <p class="exercise__hint-trigger">Un indice?</p>
        </div>
      {{/forEach}}

      {{#if nextId}}
        <button class="btn btn-primary exercise__next-btn" data-id="{{ nextId }}">
          Passer à l'exercise suivant
        </button>
      {{/if}}
    </exercise-app>
  </body>
</html>
