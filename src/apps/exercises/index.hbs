<!DOCTYPE html>
<html lang="fr-FR">
  <head>
    <meta charset="utf-8"/>
    <title>Mathrix</title>

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <base href="{{ globals 'base_href' }}">

    <link href="https://cdn.jsdelivr.net/npm/katex@0.11.1/dist/katex.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@300;400&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@500;600&display=swap" rel="stylesheet">
  </head>

  <body>
    <main id="app">
      <h1 class="main-title">{{ katex subject.name }}</h1>

      <div class="exercise__selector">
        {{#forEach exercises }}
          <button class="exercise__link" data-id="{{ id }}">{{ index }}</button>
        {{/forEach}}
      </div>

      {{#forEach exercise.contexts }}
        <div class="exercise">
          {{> wall wall=question }}

          <div class="exercise__choices">
            {{#forEach choices}}
              <button class="mtx-btn mtx-btn-secondary exercise__choice">
                {{> wall wall=this}}
              </button>
            {{/forEach}}
          </div>

          <div class="exercise__explanation">
            <h3 class="exercise__explanation-title">Explications</h3>
            {{#forEach explanations}}
              <div class="exercise__hint">
                {{> wall wall=this }}
              </div>
            {{/forEach}}
          </div>

          <p class="exercise__hint-trigger">Un indice?</p>
        </div>
      {{/forEach}}
    </main>
  </body>
</html>
