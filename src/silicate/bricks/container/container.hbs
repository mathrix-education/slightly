<div class="{{ variant }}">
  <div class="wrapper">
    <h3>
      {{#if prefix}}
        <span>{{prefix}}</span>
      {{/if}}

      {{ variantName }}

      {{#if title}}
        <span>{{title}}</span>
      {{/if}}

      {{#if suffix}}
        <span>{{suffix}}</span>
      {{/if}}
    </h3>

    {{> wall wall=wall}}
  </div>
</div>