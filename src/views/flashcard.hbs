<h1 class="main-title">{{ katex name }}</h1>

<div class="flashcards-progress">
  <div class="flashcards-progress__buffer"></div>
</div>

<button type="button" class="flashcard-mode-button">Mode entraînement</button>

<div class="flashcards-container" data-mode="revision" data-current="0">
  {{#each cards as |card|}}
    <div class="flashcard">
      <div class="front">
        {{> wall wall=front }}
      </div>
      <div class="back">
        {{> wall wall=back }}
      </div>
    </div>
  {{/each}}
</div>

<button class="flashcard-reveal-button">Voir la réponse</button>

<div class="flashcard-footer">
  <button class="flashcard-wrong__button">J'ai faux</button>
  <button class="flashcard-right__button">J'ai juste</button>
</div>